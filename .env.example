# ── Auth ────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET=replace-with-a-long-random-secret

# ── Vercel KV (added automatically when you link a KV store) ─
# Run: vercel link && vercel env pull .env.local
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# ── Google OAuth ─────────────────────────────────────────────
# Create at console.cloud.google.com → APIs & Services → Credentials
# Authorised redirect URI: https://<your-domain>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The public base URL of your deployment (no trailing slash)
NEXT_PUBLIC_BASE_URL=https://your-site.vercel.app

# ── Razorpay (INR payments) ──────────────────────────────────
# Get from razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set in razorpay.com → Settings → Webhooks — use a long random string
RAZORPAY_WEBHOOK_SECRET=

# ── Local dev only ───────────────────────────────────────────
# Leave KV vars empty to use the local JSON file fallback (data/users.json)
# For local Google OAuth set NEXT_PUBLIC_BASE_URL=http://localhost:3000
# For Razorpay testing use test mode keys (rzp_test_...)
