# ── Auth ────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET=replace-with-a-long-random-secret

# ── Vercel KV (added automatically when you link a KV store) ─
# Run: vercel link && vercel env pull .env.local
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# ── Local dev only ───────────────────────────────────────────
# Leave KV vars empty to use the local JSON file fallback (data/users.json)
